// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Enums =====================
// NUEVO

enum estado_gestion {
  ABIERTA
  CERRADA
}

enum tipo_premio {
  ORO
  PLATA
  BRONCE
  MENCION
}

enum clasificacion_estado {
  CLASIFICADO
  NO_CLASIFICADO
  DESCALIFICADO
}

enum estado_inscripcion {
  INSCRITO
  CLASIFICADO
  FINALISTA
  PREMIADO
  DESCALIFICADO
}

enum estado_registro {
  BORRADOR
  FIRMADA
}

enum estado_validacion {
  PENDIENTE
  VALIDADO
}

enum tipo_lista {
  POR_AREA_Y_NIVEL
  CLASIFICADOS
  PREMIADOS
  EXCEL_CERTIFICADOS
  WEB
}

enum fuente_lista {
  CLASIFICATORIA
  FINAL
}

enum estado_area {
  EVALUANDO
  CLASIFICANDO
  COMPLETADO
}

enum tipo_area_config {
  INDIVIDUAL
  GRUPAL
}

// ===================== Tablas =====================

model premios_otorgados {
  id_premio      Int          @id @default(autoincrement())
  id_inscripcion Int
  id_area        Int
  id_nivel       Int
  id_gestion     Int
  tipo           tipo_premio
  fuente         fuente_lista?
  generado_desde Int?
  creado_en      DateTime     @default(now())

  // opcional: redundancia
  anio           Int?

  inscripcion inscripciones    @relation(fields: [id_inscripcion], references: [id_inscripcion], onDelete: Cascade)
  area        areas            @relation(fields: [id_area], references: [id_area], onDelete: Cascade)
  nivel       niveles          @relation(fields: [id_nivel], references: [id_nivel], onDelete: Cascade)
  gestion     gestiones        @relation(fields: [id_gestion], references: [id_gestion])
  lista       listas_generadas? @relation(fields: [generado_desde], references: [id_lista])

  @@unique([id_inscripcion, id_area, id_nivel, id_gestion], name: "uq_premio_por_insc_area_nivel_gestion")
  @@index([id_area, id_nivel, id_gestion])
}

model gestiones {
  id_gestion Int            @id @default(autoincrement())
  anio       Int            // puede repetirse (varias gestiones en 2025)
  nombre     String?        // ej: "Olimpiadas Nacionales 2025 - 1ra edición"
  estado     estado_gestion @default(ABIERTA)
  created_at DateTime       @default(now())
  closed_at  DateTime?
  // Relaciones
  inscripciones        inscripciones[]
  medallero_config     medallero_config[]
  cierres_fase         cierres_fase[]
  listas_generadas     listas_generadas[]
  evaluadores_area     evaluadores_area[]
  responsables_area    responsables_area[]
  premios_otorgados    premios_otorgados[]

  areas_gestion        areas_gestion[]

  @@index([anio])
  @@index([estado])
  @@index([anio, estado])
}

model areas_gestion {
  id_area_gestion Int              @id @default(autoincrement())
  id_gestion      Int
  nombre_area     String
  nota_aprobacion Int?
  tipo            tipo_area_config @default(INDIVIDUAL)
  niveles_target  String?
  archived_at     DateTime         @default(now())

  gestion gestiones @relation(fields: [id_gestion], references: [id_gestion], onDelete: Cascade)

  @@index([id_gestion])
  @@index([archived_at])
}

model roles {
  id_rol   Int        @id @default(autoincrement()) @db.Integer
  nombre   String     @unique
  usuarios usuarios[]
}

enum ciclo_nivel {
  PRIMARIA
  SECUNDARIA
}

enum accion_log {
  REGISTRO
  MODIFICACION
}

model usuarios {
  id_usuario    Int      @id @default(autoincrement()) @db.Integer
  correo        String   @unique
  hash_password String
  nombre        String
  apellido      String
  telefono      String?
  experiencia   Int?
  especialidad  String?
  institucion   String?
  ci            String?
  activo        Boolean  @default(true)
  id_rol        Int
  rol           roles    @relation(fields: [id_rol], references: [id_rol])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  evaluaciones      evaluaciones[]      @relation("evaluaciones_evaluador")
  cierres_cerrado   cierres_fase[]      @relation("cierre_por")
  cierres_validado  cierres_fase[]      @relation("validado_por")
  responsables_area responsables_area[]
  evaluadores_area  evaluadores_area[]
  listas_generadas  listas_generadas[]
  log_cambios_nota  log_cambios_nota[]
  import_csv        import_csv[]
  reordenamientos   reordenamientos[]
}

model areas {
  id_area     Int         @id @default(autoincrement()) @db.Integer
  nombre_area String      @unique
  activo      Boolean     @default(true)
  estado      estado_area @default(EVALUANDO)

  // 2. Agrega estos campos nuevos
  nota_aprobacion Int?              @default(51) // Del 51 al 100
  nota_aprobacion_final Int?            @default(51)
  tipo            tipo_area_config? @default(INDIVIDUAL)
  niveles_target  String? // Guardaremos "Primaria, Secundaria" o uno solo como texto simple por simplicidad

  inscripciones     inscripciones[]
  medallero_config  medallero_config[]
  cierres_fase      cierres_fase[]
  evaluadores_area  evaluadores_area[]
  responsables_area responsables_area[]
  listas_generadas  listas_generadas[]
  premios_otorgados premios_otorgados[]

  grupos grupos[] @relation("area_grupos")

  @@index([nombre_area])
}

model niveles {
  id_nivel     Int    @id @default(autoincrement()) @db.Integer
  nombre_nivel String @unique
  orden        Int    @default(0)

  inscripciones    inscripciones[]
  listas_generadas listas_generadas[]
  grupos           grupos[]           @relation("nivel_grupos")

  cierres_fase      cierres_fase[]
  premios_otorgados premios_otorgados[]
  medallero_config  medallero_config[]

  @@index([nombre_nivel])
}

model tutores {
  id_tutor         Int      @id @default(autoincrement()) @db.Integer
  nombre_completo  String
  ci               String?  @unique
  correo           String?
  telefono         String   @unique
  unidad_educativa String?
  activo           Boolean  @default(true)
  created_at       DateTime @default(now())

  competidores competidores[]
  grupos       grupos[]

  @@index([telefono])
  @@index([nombre_completo])
}

model competidores {
  id_competidor Int     @id @default(autoincrement()) @db.Integer
  nombres       String
  apellidos     String
  ci            String
  escuela       String?
  departamento  String?
  tutorContacto String? @map("tutor_contacto")

  id_tutor Int?
  tutor    tutores? @relation(fields: [id_tutor], references: [id_tutor])

  nivel ciclo_nivel?
  grado Int?

  activo     Boolean  @default(true)
  created_at DateTime @default(now())

  inscripciones inscripciones[]

  grupo_miembros grupo_miembros[] @relation("competidor_miembros")
}

model grupos {
  id_grupo      Int      @id @default(autoincrement()) @db.Integer
  nombre_equipo String
  escuela       String
  departamento  String
  id_area       Int
  id_nivel      Int
  created_at    DateTime @default(now())
  created_by    Int?

  id_tutor Int?

  tutor    tutores?         @relation(fields: [id_tutor], references: [id_tutor])
  area     areas            @relation("area_grupos", fields: [id_area], references: [id_area])
  nivel    niveles          @relation("nivel_grupos", fields: [id_nivel], references: [id_nivel])
  miembros grupo_miembros[]

  @@unique([nombre_equipo, id_area, id_nivel, escuela], name: "uq_grupo_unico")
  @@index([id_area])
  @@index([id_nivel])
  @@index([id_tutor])
}

model grupo_miembros {
  id_grupo_miembro Int     @id @default(autoincrement()) @db.Integer
  id_grupo         Int
  id_competidor    Int
  rol              String?

  grupo      grupos       @relation(fields: [id_grupo], references: [id_grupo], onDelete: Cascade)
  competidor competidores @relation("competidor_miembros", fields: [id_competidor], references: [id_competidor], onDelete: Cascade)

  @@unique([id_competidor], name: "uq_competidor_en_un_solo_grupo")
  @@unique([id_grupo, id_competidor], name: "uq_miembro_por_grupo")
  @@index([id_grupo])
  @@index([id_competidor])
}

model inscripciones {
  id_inscripcion     Int                @id @default(autoincrement()) @db.Integer
  id_competidor      Int
  id_area            Int
  id_nivel           Int
  id_gestion         Int

  estado_inscripcion estado_inscripcion @default(INSCRITO)
  observaciones      String?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  puntaje_clasificacion Decimal?              @db.Decimal(5, 2)
  clasificacion         clasificacion_estado? @default(NO_CLASIFICADO)
  puntaje_final         Decimal?             @db.Decimal(5, 2)

  competidor competidores @relation(fields: [id_competidor], references: [id_competidor], onDelete: Cascade)
  area       areas        @relation(fields: [id_area], references: [id_area])
  nivel      niveles      @relation(fields: [id_nivel], references: [id_nivel])
  gestion    gestiones    @relation(fields: [id_gestion], references: [id_gestion])

  evaluaciones evaluaciones[]
  premios      premios_otorgados[]

  @@unique([id_competidor, id_area, id_nivel, id_gestion], name: "uq_insc_unica_por_gestion")
  @@index([id_competidor])
  @@index([id_area])
  @@index([id_nivel])
  @@index([id_gestion, id_area, id_nivel])
  @@index([id_area, id_nivel, clasificacion])
  @@index([id_area, id_nivel, puntaje_clasificacion])
  @@index([id_gestion, estado_inscripcion])
}


model fases {
  id_fase     Int    @id @default(autoincrement()) @db.Integer
  nombre_fase String @unique
  orden_fase  Int

  evaluaciones evaluaciones[]
  cierres_fase cierres_fase[]

  asignaciones asignacion_evaluador_fase[]
}

model evaluaciones {
  id_evaluacion     Int             @id @default(autoincrement()) @db.Integer
  id_inscripcion    Int
  id_fase           Int
  id_evaluador      Int
  nota              Decimal         @db.Decimal(5, 2)
  fecha_registro    DateTime        @default(now())
  estado_registro   estado_registro @default(BORRADOR)
  descripConceptual String?
  comentario        String?

  inscripcion inscripciones @relation(fields: [id_inscripcion], references: [id_inscripcion], onDelete: Cascade)
  fase        fases         @relation(fields: [id_fase], references: [id_fase])
  evaluador   usuarios      @relation("evaluaciones_evaluador", fields: [id_evaluador], references: [id_usuario])

  log_cambios log_cambios_nota[]

  @@unique([id_inscripcion, id_fase, id_evaluador], name: "uq_eval_unica")
  @@index([id_inscripcion])
  @@index([id_fase])
  @@index([id_evaluador])
}

model asignacion_evaluador_fase {
  id_asignacion     Int @id @default(autoincrement()) @db.Integer
  id_evaluador_area Int
  id_fase           Int
  cupo              Int @default(0)

  evaluador_area evaluadores_area @relation(fields: [id_evaluador_area], references: [id_evaluador_area], onDelete: Cascade)
  fase           fases            @relation(fields: [id_fase], references: [id_fase])

  @@unique([id_evaluador_area, id_fase], name: "uq_eval_area_fase")
}

model log_cambios_nota {
  id_log         Int        @id @default(autoincrement()) @db.Integer
  id_evaluacion  Int
  id_usuario     Int
  accion         accion_log
  valor_anterior Decimal?   @db.Decimal(5, 2)
  valor_nuevo    Decimal?   @db.Decimal(5, 2)
  ts             DateTime   @default(now())

  evaluacion evaluaciones @relation(fields: [id_evaluacion], references: [id_evaluacion], onDelete: Cascade)
  usuario    usuarios     @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_evaluacion])
  @@index([id_usuario])
  @@index([ts])
}

model responsables_area {
  id_responsable_area Int     @id @default(autoincrement()) @db.Integer
  id_usuario          Int
  id_area             Int
  id_gestion          Int
  activo              Boolean @default(true)

  usuario usuarios  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  area    areas     @relation(fields: [id_area], references: [id_area], onDelete: Cascade)
  gestion gestiones @relation(fields: [id_gestion], references: [id_gestion])

  @@unique([id_usuario, id_area, id_gestion], name: "uq_resp_area_gestion")
  @@index([id_usuario])
  @@index([id_area])
  @@index([id_gestion])
}

model evaluadores_area {
  id_evaluador_area Int     @id @default(autoincrement()) @db.Integer
  id_usuario        Int
  id_area           Int
  id_gestion        Int
  activo            Boolean @default(true)

  usuario usuarios  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  area    areas     @relation(fields: [id_area], references: [id_area], onDelete: Cascade)
  gestion gestiones @relation(fields: [id_gestion], references: [id_gestion])

  @@unique([id_usuario, id_area, id_gestion], name: "uq_eval_area_gestion")
  asignaciones asignacion_evaluador_fase[]
  
  @@index([id_usuario])
  @@index([id_area])
  @@index([id_gestion])
}

model medallero_config {
  id_medallero  Int       @id @default(autoincrement()) @db.Integer
  id_area       Int
  id_nivel      Int
  id_gestion    Int

  oros          Int       @default(0)
  platas        Int       @default(0)
  bronces       Int       @default(0)
  menciones     Int       @default(0)
  vigente_desde DateTime? @db.Date
  vigente_hasta DateTime? @db.Date

  area    areas     @relation(fields: [id_area], references: [id_area], onDelete: Cascade)
  nivel   niveles   @relation(fields: [id_nivel], references: [id_nivel])
  gestion gestiones @relation(fields: [id_gestion], references: [id_gestion])

  @@unique([id_area, id_nivel, id_gestion], name: "uq_medallero_area_nivel_gestion")
  @@index([id_area])
  @@index([id_nivel])
  @@index([id_gestion])
}

model cierres_fase {
  id_cierre         Int               @id @default(autoincrement()) @db.Integer
  id_fase           Int
  id_area           Int
  id_nivel          Int
  id_gestion        Int
  cerrado_por       Int
  fecha_cierre      DateTime          @default(now())
  estado_validacion estado_validacion @default(PENDIENTE)
  validado_por      Int?
  fecha_validacion  DateTime?

  fase        fases     @relation(fields: [id_fase], references: [id_fase])
  area        areas     @relation(fields: [id_area], references: [id_area])
  nivel       niveles   @relation(fields: [id_nivel], references: [id_nivel])
  gestion     gestiones @relation(fields: [id_gestion], references: [id_gestion])
  user_cierra usuarios  @relation("cierre_por", fields: [cerrado_por], references: [id_usuario])
  user_valida usuarios? @relation("validado_por", fields: [validado_por], references: [id_usuario])

  @@unique([id_fase, id_area, id_nivel, id_gestion], name: "uq_cierre_unico_por_gestion")
  @@index([id_area])
  @@index([id_nivel])
  @@index([id_fase])
  @@index([id_gestion])
}


model listas_generadas {
  id_lista           Int           @id @default(autoincrement()) @db.Integer
  tipo_lista         tipo_lista
  id_area            Int
  id_nivel           Int?
  id_gestion         Int
  fuente             fuente_lista?
  criterios_orden    Json?
  contenido_snapshot Json?
  generado_por       Int
  fecha_generacion   DateTime      @default(now())

  area    areas     @relation(fields: [id_area], references: [id_area])
  nivel   niveles?  @relation(fields: [id_nivel], references: [id_nivel])
  gestion gestiones @relation(fields: [id_gestion], references: [id_gestion])
  usuario usuarios  @relation(fields: [generado_por], references: [id_usuario])

  reordenamientos   reordenamientos[]
  premios_otorgados premios_otorgados[]

  @@index([id_area])
  @@index([id_nivel])
  @@index([id_gestion])
  @@index([tipo_lista])
}

model reordenamientos {
  id_reorden     Int      @id @default(autoincrement()) @db.Integer
  id_lista       Int
  id_usuario     Int
  nueva_posicion Json
  fecha_reorden  DateTime @default(now())

  lista   listas_generadas @relation(fields: [id_lista], references: [id_lista], onDelete: Cascade)
  usuario usuarios         @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_lista])
}

model import_csv {
  id_import       Int      @id @default(autoincrement()) @db.Integer
  archivo_nombre  String
  total_registros Int      @default(0)
  ok              Int      @default(0)
  con_error       Int      @default(0)
  mapeo_campos    Json?
  ejecutado_por   Int
  fecha_ejecucion DateTime @default(now())
  detalle_errores Json?

  usuario usuarios @relation(fields: [ejecutado_por], references: [id_usuario])

  @@index([ejecutado_por])
}